// Random-tree test vectors

use aiken/csmt.{
  Proof, ProofStep, delete, from_root, has, insert, is_empty, miss, root,
}
use aiken/csmt/hashing.{Indirect}

test rand_has_uniform_k1_n1_m00() {
  let trie =
    from_root(
      #"5ffe25467831a8a8837e5b14699160b954328bad431d0b87cf0f973e207aa176",
    )
  let proof = Proof { root_jump: #"0101010000000100", steps: [] }
  has(
    trie,
    #"e2",
    #"28e5501c42b98551b3b9dfb95426a2e40292071665cdbb0e97d9bed5121e",
    proof,
  )
}

test rand_miss_uniform_k1_n1_a00() {
  let trie =
    from_root(
      #"5ffe25467831a8a8837e5b14699160b954328bad431d0b87cf0f973e207aa176",
    )
  let proof =
    Proof {
      root_jump: #"01",
      steps: [
        ProofStep {
          consumed: 7,
          sibling: Indirect {
            jump: #"010000000100",
            hash: #"d286235c01d5633074a1769e6da23973fafb7a093b500242721ef03fca13258d",
          },
        },
      ],
    }
  miss(trie, #"bc", proof)
}

test rand_insert_uniform_k1_n1_a00() {
  let proof =
    Proof {
      root_jump: #"01",
      steps: [
        ProofStep {
          consumed: 7,
          sibling: Indirect {
            jump: #"010000000100",
            hash: #"d286235c01d5633074a1769e6da23973fafb7a093b500242721ef03fca13258d",
          },
        },
      ],
    }
  let old_trie =
    from_root(
      #"5ffe25467831a8a8837e5b14699160b954328bad431d0b87cf0f973e207aa176",
    )
  let trie = insert(old_trie, #"bc", #"b12dac", proof)
  root(trie) == #"f77b6a0f8469cfdecbf11f8cbc3ecc4b6f5a9cc192babeccf878dc5b4367bc9e"
}

